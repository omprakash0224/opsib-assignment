# ==============================================================================
# OPSIB Retail Exception & Reliability Engine - Environment Configuration
# ==============================================================================
# Copy this template file to '.env' to configure local runtime settings.
# All parameters have safe defaults configured in app/config.py for zero-config
# local execution and offline deterministic testing.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence Configuration (ADR-8)
# ------------------------------------------------------------------------------
# Connection URI for SQLAlchemy 2.0.
# Defaults to SQLite in WAL mode (sqlite:///./opsib.db) for zero-dependency local runs.
# For production deployments, specify a PostgreSQL connection string.
#
# Examples:
#   SQLite:     sqlite:///./opsib.db
#   PostgreSQL: postgresql://postgres:postgres@localhost:5432/opsib
#   PostgreSQL: postgresql+psycopg2://user:password@db-host:5432/opsib
DATABASE_URL=sqlite:///./opsib.db

# ------------------------------------------------------------------------------
# 2. Multi-Tenancy & Rule Engine Governance
# ------------------------------------------------------------------------------
# Default tenant partition context used when the 'X-Tenant-ID' HTTP header
# is omitted in incoming API requests.
DEFAULT_TENANT_ID=TENANT-001

# Active rule version tag (v1.0.0).
# Embedded into all detected OperationalException records to guarantee auditability.
RULE_VERSION=v1.0.0

# ------------------------------------------------------------------------------
# 3. Application Logging & Observability
# ------------------------------------------------------------------------------
# Console log level verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. AI Advisory Investigation & OpenRouter Gateway (Task D / ADR-7)
# ------------------------------------------------------------------------------
# Active AI provider for generating grounded investigation summaries:
# - 'mock'       : Fully deterministic, offline, zero-cost mock with pre-canned valid citations.
# - 'openrouter' : Live LLM completions via OpenRouter.ai (requires OPENROUTER_API_KEY).
# If left blank or unset, defaults to 'openrouter' if OPENROUTER_API_KEY is present, else 'mock'.
AI_PROVIDER=mock

# OpenRouter API Key (https://openrouter.ai/keys)
# Required only if AI_PROVIDER is set to 'openrouter'.
OPENROUTER_API_KEY=

# OpenRouter Model Identifier
# Recommended models: anthropic/claude-3.5-sonnet, openai/gpt-4o, or deepseek/deepseek-chat
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OpenRouter Base URL (OpenAI-compatible completions endpoint)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# HTTP Referer header sent to OpenRouter for request attribution and leaderboard ranking
OPENROUTER_HTTP_REFERER=https://opsib.internal

# Client timeout in seconds for AI completions before returning a 502 Bad Gateway fallback
AI_REQUEST_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 5. Local Development Server Configuration (Optional)
# ------------------------------------------------------------------------------
# Host interface and port for uvicorn server execution
# HOST=0.0.0.0
# PORT=8000
